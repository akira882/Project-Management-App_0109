// Prisma Schema for Project Management App
// Database: SQLite for development, PostgreSQL for production

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User Model
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  image     String?
  role      UserRole @default(USER)

  // External Integrations
  githubUsername String?
  slackUserId    String?

  // Relations
  projects         Project[]
  assignedTasks    Task[]           @relation("AssignedTasks")
  githubIntegration GitHubIntegration?
  slackIntegration  SlackIntegration?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

enum UserRole {
  USER
  ADMIN
  MANAGER
}

// Project Model
model Project {
  id          String          @id @default(uuid())
  name        String
  description String?
  status      ProjectStatus   @default(PLANNING)
  priority    ProjectPriority @default(MEDIUM)

  // Dates
  startDate   DateTime?
  endDate     DateTime?

  // External Integrations
  githubRepoUrl   String?
  slackChannelId  String?

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks  Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([priority])
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Task Model
model Task {
  id          String       @id @default(uuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)

  // Time tracking
  dueDate        DateTime?
  estimatedHours Float?
  actualHours    Float?

  // Tags (stored as comma-separated string for SQLite)
  tags String? @default("")

  // GitHub Integration
  githubIssueNumber Int?
  githubIssueUrl    String?

  // Relations
  projectId  String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@index([priority])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// GitHub Integration Model
model GitHubIntegration {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken  String
  refreshToken String?
  username     String
  avatarUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Slack Integration Model
model SlackIntegration {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken String
  teamId      String
  teamName    String
  webhookUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
