// Prisma Schema for Project Management App
// Database: SQLite for development, PostgreSQL for production
//
// NOTE: SQLite does not support Prisma enums, so all enum-like fields are
// stored as String. Allowed values are validated at the API layer with the
// Zod schemas in @project-management/shared (single source of truth).
//   UserRole:        USER | ADMIN | MANAGER
//   ProjectStatus:   PLANNING | IN_PROGRESS | ON_HOLD | COMPLETED | ARCHIVED
//   Priority:        LOW | MEDIUM | HIGH | URGENT
//   TaskStatus:      TODO | IN_PROGRESS | IN_REVIEW | DONE | BLOCKED
//   AttendanceStatus: WORKING | ON_BREAK | COMPLETED

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User Model
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  image     String?
  role      String   @default("USER")

  // External Integrations
  githubUsername String?
  slackUserId    String?

  // Relations
  projects          Project[]
  assignedTasks     Task[]             @relation("AssignedTasks")
  attendanceRecords AttendanceRecord[]
  githubIntegration GitHubIntegration?
  slackIntegration  SlackIntegration?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

// Project Model
model Project {
  id          String  @id @default(uuid())
  name        String
  description String?
  status      String  @default("PLANNING")
  priority    String  @default("MEDIUM")

  // Dates
  startDate   DateTime?
  endDate     DateTime?

  // External Integrations
  githubRepoUrl   String?
  slackChannelId  String?

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks  Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([priority])
}

// Task Model
model Task {
  id          String  @id @default(uuid())
  title       String
  description String?
  status      String  @default("TODO")
  priority    String  @default("MEDIUM")

  // Time tracking
  dueDate        DateTime?
  estimatedHours Float?
  actualHours    Float?

  // Tags (stored as comma-separated string for SQLite)
  tags String? @default("")

  // GitHub Integration
  githubIssueNumber Int?
  githubIssueUrl    String?

  // Relations
  projectId  String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@index([priority])
}

// Attendance Record Model (勤怠打刻)
// One record per user per work day (JST). workDate is a "YYYY-MM-DD" string
// computed in JST on the server so that early-morning punches never slip to
// the previous day (classic UTC date-boundary bug).
model AttendanceRecord {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Work day in JST, e.g. "2026-06-11" (string keeps SQLite simple and sortable)
  workDate String

  // Punches
  clockInAt    DateTime
  clockOutAt   DateTime?
  breakStartAt DateTime? // set while on break, cleared when break ends
  breakMinutes Int       @default(0) // accumulated break time
  workMinutes  Int? // computed server-side at clock-out: (out - in) - break

  // WORKING | ON_BREAK | COMPLETED
  status String @default("WORKING")

  note String?

  // Optional GPS evidence (reserved for future field verification)
  clockInLat  Float?
  clockInLng  Float?
  clockOutLat Float?
  clockOutLng Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, workDate])
  @@index([userId])
  @@index([workDate])
  @@index([status])
}

// GitHub Integration Model
model GitHubIntegration {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken  String
  refreshToken String?
  username     String
  avatarUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Slack Integration Model
model SlackIntegration {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken String
  teamId      String
  teamName    String
  webhookUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
