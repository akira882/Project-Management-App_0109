# ───────────────────────────────────────────────────────────
# WorkManagementApp 環境変数サンプル
# このファイルを .env にコピーして値を設定してください。
# .env は絶対にコミットしないこと（.gitignore 済み）。
# ───────────────────────────────────────────────────────────

# Supabase プロジェクト設定（Supabase ダッシュボード > Project Settings > API）
# EXPO_PUBLIC_ プレフィックスはクライアントに埋め込まれる公開値。
# anon キーは公開前提（RLS で保護）。service_role キーはクライアントに置かない。
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME_ANON_KEY

# アプリ動作モード
APP_ENV=development
DEBUG_MODE=true

# ── サーバ/管理用途のみ（クライアントに絶対に入れない） ──
# service_role キーは Supabase Edge Function やサーバ環境でのみ使用すること。
# SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_DO_NOT_COMMIT_OR_SHIP_TO_CLIENT
