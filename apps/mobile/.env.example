# モバイルアプリ用環境変数
# このファイルは.gitignoreに含まれています

# API設定
API_BASE_URL=http://localhost:3000
# 本番環境では以下のように設定してください：
# API_BASE_URL=https://your-production-api.vercel.app

# タイムアウト設定（ミリ秒）
API_TIMEOUT=30000

# GitHub API（オプション - 外部連携機能を使用する場合）
# GITHUB_PERSONAL_ACCESS_TOKEN=ghp_xxxxxxxxxxxxx

# Slack Webhook（オプション - Slack通知機能を使用する場合）
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# アプリ設定
APP_ENV=development
# 本番環境では: APP_ENV=production

# デバッグモード
DEBUG_MODE=true
